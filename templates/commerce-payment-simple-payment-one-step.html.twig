{#
/**
 * @file
 * Template for the secure payment page.
 */
#}
<div class="container">
    <div class="payment-container">
        <div class="payment-form">
            <div class="header">
                <h2><i class="fas fa-lock"></i> Paiement Sécurisé</h2>
                <p>Finalisez votre commande en toute sécurité</p>
            </div>
            
            <form id="payment-form">
                <div class="form-group">
                    <label for="card-number">Numéro de carte</label>
                    <div class="input-group">
                        <i class="far fa-credit-card"></i>
                        <input type="text" id="card-number" placeholder="1234 5678 9012 3456" maxlength="19">
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="cardholder">Nom du titulaire</label>
                    <div class="input-group">
                        <i class="far fa-user"></i>
                        <input type="text" id="cardholder" placeholder="Jean DUPONT">
                    </div>
                </div>
                
                <div class="card-details">
                    <div class="form-group">
                        <label for="expiry-date">Date d'expiration</label>
                        <div class="input-group">
                            <i class="far fa-calendar-alt"></i>
                            <input type="text" id="expiry-date" placeholder="MM/AA" maxlength="5">
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="cvv">Code de sécurité</label>
                        <div class="input-group">
                            <i class="fas fa-shield-alt"></i>
                            <input type="text" id="cvv" placeholder="123" maxlength="3">
                        </div>
                    </div>
                </div>
                
                <div class="security-badges">
                    <div class="badge">
                        <i class="fas fa-lock"></i>
                        <span>Paiement<br>sécurisé SSL</span>
                    </div>
                    <div class="badge">
                        <i class="fas fa-shield-alt"></i>
                        <span>Protection<br>anti-fraude</span>
                    </div>
                    <div class="badge">
                        <i class="fas fa-user-shield"></i>
                        <span>Vos données<br>protégées</span>
                    </div>
                </div>
                
                <button type="submit" class="btn-pay">
                    <i class="fas fa-lock"></i> Payer maintenant 190,00 €
                </button>
                
                <a href="#" class="back-link">
                    <i class="fas fa-arrow-left"></i> Retour à la commande
                </a>
            </form>
        </div>
        
        <div class="order-summary">
            <h2><i class="fas fa-shopping-bag"></i> Votre Commande</h2>
            
            <div class="order-items">
                <div class="order-item">
                    <div>
                        <strong>Site E-commerce Premium</strong>
                        <div style="font-size: 0.9rem; opacity: 0.9;">Livraison en 72h</div>
                    </div>
                    <div>190,00 €</div>
                </div>
                
                <div class="order-item">
                    <div>
                        <strong>Hébergement 1 mois offert</strong>
                        <div style="font-size: 0.9rem; opacity: 0.9;">Valeur 9,90 €</div>
                    </div>
                    <div>0,00 €</div>
                </div>
                
                <div class="order-item">
                    <div>
                        <strong>Formation incluse</strong>
                        <div style="font-size: 0.9rem; opacity: 0.9;">1 heure de formation</div>
                    </div>
                    <div>0,00 €</div>
                </div>
            </div>
            
            <div class="order-total">
                <div>Total TTC</div>
                <div>190,00 €</div>
            </div>
            
            <div class="guarantee">
                <i class="fas fa-award"></i>
                <h3>Garantie Satisfait ou Remboursé</h3>
                <p>14 jours pour changer d'avis. Remboursement intégral si insatisfait.</p>
            </div>
            
            <div class="payment-methods">
                <div class="payment-method">VISA</div>
                <div class="payment-method">MC</div>
                <div class="payment-method">CB</div>
                <div class="payment-method">PP</div>
            </div>
        </div>
    </div>
</div>