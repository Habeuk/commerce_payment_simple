{#
/**
 * @file
 * Template for the secure payment page.
 */
#}
<section class="full-page-payments">
    <div class="container">
        <div class="payment-container d-flex justify-content-center mx-auto margin-top margin-bottom width-tablet">        
            <div class="payment-form d-flex flex-column justify-content-between">
                <div class="header text-center">
                    <h3><i class="fas fa-lock"></i> Paiement Sécurisé</h3>
                    <p>Finalisez votre commande en toute sécurité</p>
                </div>
                	{% if stripe_public_key and client_secret and return_url %}
                	    {{ element['#form']}}
                		{#
                    		<label for="exampleFormControlInput1" class="form-label">Methode de paiement</label>
                        	<div class="payment-form-element width-phone" data-return_url="{{ return_url }}" data-stripe_public_key="{{ stripe_public_key }}" data-client_secret="{{ client_secret }}">
                              <div class="payment-element">
                                Chargement encours ...
                              </div>
                              <span class="submit-payment btn mt-5 btn-wbu-secondary w-100 border-radius-10 fw-light btn-lg">
                                <span class="spinner hidden" id="spinner"></span>
                                <span class="button-text"> {{ text_button_payment }} </span>
                              </span>
                              <div class="hidden payment-message"></div>
                            </div>      
                        #}                  
                        {% else %}
                        <div class="alert alert-danger border-radius-10 margin-top margin-bottom"> <h4>Erreur de configuration</h4> <p> veillez essayer plus tard</p> </div>                        
                    {% endif %}   
                <div class="security-badges bg-wbu-thirdly border-radius-10">
                    <div class="badge">
                        <div class="mb-2"> {% include '@commerce_payment_simple/includes/ssl-icon.html.twig' %} </div>
                        <span>Paiement<br>sécurisé SSL</span>
                    </div>
                    <div class="badge">
                        <div class="mb-2"> {% include '@commerce_payment_simple/includes/safe-icon.html.twig' %} </div>
                        <span>Protection<br>anti-fraude</span>
                    </div>
                    <div class="badge">
                        <div class="mb-2"> {% include '@commerce_payment_simple/includes/privacy-icon.html.twig' %} </div>
                        <span>Vos données<br>protégées</span>
                    </div>
                </div>
                <div class="mt-3"> <a href="/node/182" class="back-link"> <i class="fas fa-arrow-left"></i> Retour à la commande  </a> </div>
            </div>            
            <div class="order-summary">
                <h3 class="title d-flex justify-content-center align-items-baseline"> {% include '@commerce_payment_simple/includes/shopping-bag-icon.html.twig' %} Votre Commande </h3 >                
                <div class="order-items">
                    {% for item in order.getItems() %}
                        <div class="order-item">
                            <div>
                                <strong>{{ item.label() }}</strong>
                                <div class="opacity-50 small">Livraison en 72h</div>
                            </div>
                            <div>{{ item.getTotalPrice()|commerce_price_format }}</div>
                        </div>
                    {% endfor %}                   
                    <div class="order-item">
                        <div>
                            <strong>Hébergement 1 mois offert</strong>
                            <div class="opacity-50 small">Valeur 9,90 €</div>
                        </div>
                        <div>0,00 €</div>
                    </div>                    
                    <div class="order-item">
                        <div>
                            <strong>Formation incluse</strong>
                            <div class="opacity-50 small">1 heure de formation</div>
                        </div>
                        <div>0,00 €</div>
                    </div>
                </div>                
                <div class="order-total h4 fw-bold">
                    <div>Total TTC</div>
                    <div>190,00 €</div>
                </div>                
                <div class="guarantee">                
                    <div class="mb-2"> {% include '@commerce_payment_simple/includes/achievement-award-medal.html.twig' %} </div>
                    <h3 class="h4">Garantie Satisfait ou Remboursé</h3>
                    <p>14 jours pour changer d'avis. Remboursement intégral si insatisfait.</p>
                </div>                
                <div class="payment-methods">
                    <div class="payment-method">VISA</div>
                    <div class="payment-method">MC</div>
                    <div class="payment-method">CB</div>
                    <div class="payment-method">PP</div>
                </div>
            </div>
        </div>
    </div>
</section>